---
import { getHomeSections } from '../lib/home';

const onHome = Astro.url.pathname === '/';
const href = (hash: string) => (onHome ? `#${hash}` : `/#${hash}`);
const available = await getHomeSections();

const sections = [
  available.releases && { href: href('releases'), label: 'New releases' },
  available.live && { href: href('live'), label: 'Live in Europe' },
  available.channels && { href: href('from-our-channels'), label: 'From our channels' },
  available.articles && { href: href('articles'), label: 'Latest articles' },
].filter((item): item is { href: string; label: string } => Boolean(item));
---

<footer class="foot">
  <div class="horizon" aria-hidden="true">
    {/* night-europe.jpg: CME's own image, rights-cleared. Decorative background. */}
    <img src="/brand/night-europe.jpg" alt="" />
  </div>
  <div class="foot-overlay" aria-hidden="true"></div>
  <div class="wrap">
    <div class="grid">
      <div style="grid-column:1/5">
        <img src="/brand/logo-full-light.png" style="width:300px" alt="Christian Music Europe" />
      </div>
      {sections.length > 0 && (
        <div style="grid-column:6/8">
          <h5>Sections</h5>
          <ul>
            {sections.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      )}
      <div style="grid-column:8/10">
        <h5>Discover</h5>
        <ul>
          <li><a href={href('countries')}>Country map</a></li>
          <li><a href="/countries/">All countries</a></li>
        </ul>
      </div>
      {/* Plain labels until official CME profile URLs are published. "Follow CME" on the homepage points here. */}
      <div style="grid-column:10/13" id="follow-cme">
        <h5>Follow</h5>
        <ul>
          <li>X</li>
          <li>Instagram</li>
          <li>YouTube</li>
          <li>Spotify</li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span class="meta">&copy; Christian Music Europe</span>
    </div>
  </div>
</footer>
