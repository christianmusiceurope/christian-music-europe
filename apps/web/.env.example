PUBLIC_SANITY_PROJECT_ID=rg6onak7
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-10-25

# sanity (default when unset) reads published documents from the dataset above.
# fixture is the offline opt-in for dev and tests (local LIN D data, no network).
# Drafts need SANITY_API_READ_TOKEN in the server environment only.
# Do not prefix that token with PUBLIC_ and do not commit it.
PUBLIC_CME_DATA_SOURCE=sanity

# true shows photos whose rights status is restricted, with a Permission pending label.
# Dev and preview builds only. Production builds ignore this flag. Leave it unset for launch.
PUBLIC_CME_ALLOW_PENDING_IMAGES=false

# true builds a local /dev/social-strip/preview/ page with fixture states for screenshots.
# Leave unset in production builds.
PUBLIC_CME_SOCIAL_STRIP_PREVIEW=false
