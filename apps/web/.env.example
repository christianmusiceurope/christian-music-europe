PUBLIC_SANITY_PROJECT_ID=rg6onak7
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-10-25

# fixture (default) renders local fixtures, including /artists/lin-d.
# sanity reads published documents from the dataset above.
# LIN D is a draft. To read drafts, set SANITY_API_READ_TOKEN in the server
# environment only. Do not prefix it with PUBLIC_ and do not commit the token.
PUBLIC_CME_DATA_SOURCE=fixture

# true shows photos whose rights status is restricted, with a Permission pending label.
# Dev and preview builds only. Production builds ignore this flag. Leave it unset for launch.
PUBLIC_CME_ALLOW_PENDING_IMAGES=false
