---
import ArtistProfile from '../../components/ArtistProfile.astro';
import Layout from '../../layouts/Layout.astro';
import { getArtist, getArtistSlugs } from '../../lib/artists';
import { firstSentence, portablePlainText } from '../../lib/text';
import { spotifyArtistUrl } from '../../lib/youtube';
import type { ArtistPageData } from '../../lib/types';

export async function getStaticPaths() {
  const slugs = await getArtistSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug;
if (!slug) throw new Error('Artist slug is missing.');

const artist = await getArtist(slug);
if (!artist) throw new Error(`No artist content for slug "${slug}".`);

const pageArtist: ArtistPageData = {
  ...artist,
  languages: artist.languages ?? [],
  biography: artist.biography ?? [],
  countries: artist.countries ?? [],
  genres: artist.genres ?? [],
  articles: artist.articles ?? [],
  releases: artist.releases ?? [],
  events: artist.events ?? [],
  videos: artist.videos ?? [],
  sources: artist.sources ?? [],
};

const biography = portablePlainText(pageArtist.biography);
const description =
  firstSentence(biography) || `${pageArtist.name} on Christian Music Europe.`;
const sameAs = [
  pageArtist.website,
  spotifyArtistUrl(pageArtist.spotifyArtistId),
  pageArtist.youtubeUrl,
  pageArtist.instagramUrl,
  pageArtist.tiktokUrl,
  pageArtist.xUrl,
  pageArtist.facebookUrl,
].filter((url): url is string => Boolean(url));
const origin = pageArtist.countries.find(
  (country) => country.relationshipType === 'origin' || country.relationshipType === 'formed_in',
);

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': pageArtist.artistType === 'solo' ? 'Person' : 'MusicGroup',
  name: pageArtist.name,
  description: biography || description,
  genre: pageArtist.genres.map((genre) => genre.name),
  sameAs,
  url: pageArtist.website,
};

if (origin && pageArtist.artistType !== 'solo') {
  jsonLd.foundingLocation = {
    '@type': 'Country',
    name: origin.name,
  };
}

---

<Layout
  title={`${pageArtist.name} | Christian Music Europe`}
  description={description}
  header="compact"
  ogType="profile"
  jsonLd={jsonLd}
>
  <ArtistProfile artist={pageArtist} />
</Layout>
