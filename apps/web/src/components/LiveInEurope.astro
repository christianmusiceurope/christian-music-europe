---
import SectionHead from './SectionHead.astro';
import { eventDateParts, formatEventWhen } from '../lib/dates';
import type { ArtistRef, HomeEvent, LiveRow } from '../lib/home';

interface Props {
  rows: LiveRow[];
}

const { rows } = Astro.props;

function ticketLabel(status: string | undefined): string {
  if (status === 'on_sale') return 'On sale';
  if (status === 'sold_out') return 'Sold out';
  if (status === 'announced') return 'Tickets announced';
  return 'Tickets';
}

function action(event: HomeEvent): { href: string; label: string } | undefined {
  if (event.ticketUrl) return { href: event.ticketUrl, label: ticketLabel(event.ticketStatus) };
  if (event.officialSourceUrl) return { href: event.officialSourceUrl, label: 'Details' };
  return undefined;
}

function linkedArtists(artists: ArtistRef[]): ArtistRef[] {
  return artists.filter((artist) => artist.name);
}

function place(city?: string, country?: string): string {
  return [city, country].filter(Boolean).join(', ');
}

function dayMonth(iso: string, timeZone?: string): { day: string; month: string } | undefined {
  const parts = eventDateParts(iso, timeZone);
  if (!parts) return undefined;
  try {
    const month = new Intl.DateTimeFormat('en-GB', { month: 'short', timeZone: timeZone || 'UTC' })
      .format(new Date(iso))
      .toUpperCase();
    return { day: parts.day, month };
  } catch {
    return undefined;
  }
}

function festivalDates(events: HomeEvent[]): string | undefined {
  const first = events[0];
  const last = events[events.length - 1];
  const fmt = (event: HomeEvent) => {
    try {
      return new Intl.DateTimeFormat('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: event.timezone || 'UTC',
      }).format(new Date(event.startDateTime));
    } catch {
      return undefined;
    }
  };
  const start = fmt(first);
  const end = fmt(last);
  if (!start) return undefined;
  if (!end || start === end) return start;
  const [sd, sm, sy] = start.split(' ');
  const [ed, em, ey] = end.split(' ');
  if (sy === ey && sm === em) return `${sd} to ${ed} ${em} ${ey}`;
  if (sy === ey) return `${sd} ${sm} to ${ed} ${em} ${ey}`;
  return `${start} to ${end}`;
}
---

{
  rows.length > 0 && (
    <section class="wrap home-block" id="live">
      <SectionHead title="Live in Europe" subline="Upcoming dates" />
      <div class="home-live">
        {rows.map((row) => {
          if (row.kind === 'event') {
            const event = row.event;
            const date = dayMonth(event.startDateTime, event.timezone);
            const when = formatEventWhen(event.startDateTime, event.timezone);
            const artists = linkedArtists(event.artists);
            const single = artists.length === 1 && artists[0].slug ? artists[0] : undefined;
            const link = action(event);
            return (
              <article class="ev-row">
                <div class="d">
                  {date?.day}
                  {date && <small>{date.month}</small>}
                </div>
                <div>
                  <h3>{single ? <a href={`/artists/${single.slug}/`}>{event.title}</a> : event.title}</h3>
                  <p class="where">{[when, event.venueName].filter(Boolean).join(' · ')}</p>
                  {!single && artists.length > 0 && (
                    <p class="who">
                      {artists.map((artist, index) => (
                        <>
                          {index > 0 && ', '}
                          {artist.slug ? <a href={`/artists/${artist.slug}/`}>{artist.name}</a> : artist.name}
                        </>
                      ))}
                    </p>
                  )}
                </div>
                <div class="place">{place(event.city, event.countryName)}</div>
                <div class="t">
                  {link && (
                    <a class="btn ghost" href={link.href} rel="noopener noreferrer" target="_blank">
                      {link.label}
                    </a>
                  )}
                </div>
              </article>
            );
          }
          const first = row.events[0];
          const date = dayMonth(first.startDateTime, first.timezone);
          const range = festivalDates(row.events);
          return (
            <article class="ev-row festival">
              <div class="d">
                {date?.day}
                {date && <small>{date.month}</small>}
              </div>
              <div>
                <p class="kind">Festival</p>
                <h3>
                  {row.festival.website ? (
                    <a href={row.festival.website} rel="noopener noreferrer" target="_blank">
                      {row.festival.name}
                    </a>
                  ) : (
                    row.festival.name
                  )}
                </h3>
                {range && <p class="where">{range}</p>}
                <ul class="lineup">
                  {row.events.map((event) => {
                    const when = formatEventWhen(event.startDateTime, event.timezone);
                    const artists = linkedArtists(event.artists);
                    const link = action(event);
                    return (
                      <li>
                        <span class="who">
                          {artists.length > 0
                            ? artists.map((artist, index) => (
                                <>
                                  {index > 0 && ', '}
                                  {artist.slug ? <a href={`/artists/${artist.slug}/`}>{artist.name}</a> : artist.name}
                                </>
                              ))
                            : event.title}
                        </span>
                        <span class="when">{[when, event.venueName].filter(Boolean).join(' · ')}</span>
                        {link && (
                          <a class="mini" href={link.href} rel="noopener noreferrer" target="_blank">
                            {link.label}
                          </a>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
              <div class="place">{place(row.city, row.countryName)}</div>
              <div class="t"></div>
            </article>
          );
        })}
      </div>
    </section>
  )
}
