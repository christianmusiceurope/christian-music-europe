---
interface Props {
  current?: 'home' | 'discover' | 'live';
}

const current = Astro.props.current;
const onHome = Astro.url.pathname === '/';
const href = (hash: string) => (onHome ? `#${hash}` : `/#${hash}`);
---

<nav class="tabbar m-only" aria-label="Shortcuts">
  <a href="/" class={current === 'home' ? 'on' : undefined} aria-current={current === 'home' ? 'page' : undefined}>
    <svg class="ico"><use href="#i-home" /></svg>
    Home
  </a>
  <a href={href('countries')} class={current === 'discover' ? 'on' : undefined}>
    <svg class="ico"><use href="#i-globe" /></svg>
    Discover
  </a>
  <a href={href('live')} class={current === 'live' ? 'on' : undefined}>
    <svg class="ico"><use href="#i-live" /></svg>
    Live
  </a>
  <a href="#menu" data-menu-open aria-expanded="false" aria-controls="menu">
    <svg class="ico"><use href="#i-menu" /></svg>
    Menu
  </a>
</nav>
