---
/**
 * Homepage. Every block reads published Sanity documents and hides when empty.
 * There is no demo or hardcoded content on this page.
 */
import ArtistSpotlight from '../components/ArtistSpotlight.astro';
import EuropeDotMap from '../components/EuropeDotMap.astro';
import HomeReleases from '../components/HomeReleases.astro';
import LatestArticles from '../components/LatestArticles.astro';
import Layout from '../layouts/Layout.astro';
import LiveInEurope from '../components/LiveInEurope.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import SocialChannels from '../components/SocialChannels.astro';
import { getHomeContent } from '../lib/home';
import { getMapData } from '../lib/map';
import { getCurrentSpotlight } from '../lib/spotlight';

const [spotlight, mapData, home] = await Promise.all([getCurrentSpotlight(), getMapData(), getHomeContent()]);
---

<Layout
  title="Christian Music Europe"
  description="Christian music from every corner of Europe: artists, releases and live dates."
  header="home"
  current="home"
  tab="home"
>
  {spotlight && <ArtistSpotlight spotlight={spotlight} />}

  <HomeReleases releases={home.releases} />

  <LiveInEurope rows={home.live} />

  <SocialChannels posts={home.posts} companion={{ kind: 'follow' }} />

  <EuropeDotMap data={mapData} id="countries" showLists={false} linkHref="/countries/" linkLabel="Explore all countries" />

  <LatestArticles articles={home.articles} />

  <NewsletterBand />
</Layout>
