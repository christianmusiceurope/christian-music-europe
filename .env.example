PUBLIC_SANITY_PROJECT_ID=rg6onak7
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-10-25

# Web content source. Unset or sanity reads published documents from rg6onak7/production.
# fixture is the offline opt-in. Drafts need SANITY_API_READ_TOKEN (not PUBLIC_).
PUBLIC_CME_DATA_SOURCE=sanity

# true shows restricted photos on dev and preview builds, with a Permission pending label.
# Production builds ignore this flag. Leave it unset or false for launch.
PUBLIC_CME_ALLOW_PENDING_IMAGES=false

SANITY_STUDIO_PROJECT_ID=yourProjectId
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2026-10-25

SANITY_SEED_DATASET=development
# Write token for the development seed script only. Never commit the real token.
SANITY_API_WRITE_TOKEN=
