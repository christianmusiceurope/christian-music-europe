---
/**
 * Dot-matrix Europe map.
 * Artists and Releases modes keep the dots grey and put one orange count
 * marker at each country's visual centre (europe-dots.json `centres`): the
 * number of artists, or of new releases. The selected country turns purple.
 * Events mode lights one dot per venue city.
 * Every dot has an invisible full-cell hit area, so there are no gaps between
 * clickable areas.
 * The grid comes from src/data/europe-dots.json (scripts/europe-dots).
 */
import SectionHead from './SectionHead.astro';
import type { MapData } from '../lib/map';

interface Props {
  data: MapData;
}

const { data } = Astro.props;
const { grid, countries, events } = data;
const R = 0.36;
const ER = 0.5;

const byCode = new Map(countries.map((c) => [c.code, c]));
const countOnMap = new Map<string, number>();
for (const c of countries) {
  if (!c.artists.length) continue;
  countOnMap.set(c.mapCode, (countOnMap.get(c.mapCode) ?? 0) + c.artists.length);
}

// Flattened dot positions, same order as lib/map.ts dotOffsets().
const positions: Array<[number, number]> = [];
for (const cells of Object.values(grid.dots)) {
  for (let n = 0; n < cells.length; n += 2) positions.push([cells[n], cells[n + 1]]);
}

// Only European countries get dots; ones not in Sanity's European list stay muted and inert.
const groups = Object.entries(grid.dots).map(([code, cells]) => {
  const c = byCode.get(code);
  const n = countOnMap.get(code) ?? 0;
  const circles: string[] = [];
  let hit = '';
  for (let k = 0; k < cells.length; k += 2) {
    circles.push(`<circle cx="${cells[k] + 0.5}" cy="${cells[k + 1] + 0.5}" r="${R}"/>`);
    hit += `M${cells[k]} ${cells[k + 1]}h1v1h-1z`;
  }
  // Invisible union of the country's full grid cells: clicks between dots still hit the country.
  const hitPath = c ? `<path class="dmap-hit" d="${hit}"/>` : '';
  return { code, name: c?.name, inScope: Boolean(c), n, html: hitPath + circles.join('') };
});

// One event dot per distinct map dot.
const evDots = new Map<number, { cities: Set<string>; code: string }>();
for (const e of events) {
  if (e.dot === null) continue;
  const d = evDots.get(e.dot) ?? { cities: new Set<string>(), code: e.countryCode };
  d.cities.add(e.city);
  evDots.set(e.dot, d);
}

const withArtists = countries.filter((c) => c.artists.length > 0);
const withoutArtists = countries.filter((c) => c.artists.length === 0 && c.hasDots);
const initials = (name: string) =>
  name.replace(/[^\p{L}\p{N}\s]/gu, ' ').trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '?';
const totalArtists = new Set(countries.flatMap((c) => c.artists.map((a) => a.slug))).size;

const clientData = {
  countries: countries.map((c) => ({
    code: c.code,
    name: c.name,
    slug: c.slug,
    mapCode: c.mapCode,
    artists: c.artists,
  })),
  events,
  releases: data.releases,
  centres: grid.centres,
};
const json = JSON.stringify(clientData).replaceAll('<', '\\u003c');
---

<section class="dmap" id="map" data-dmap>
  <div class="wrap">
    <SectionHead title="Discover by country" />
    <p class="dmap-lede">
      {totalArtists} artists from {withArtists.length} countries. Pick a country to meet its artists, switch to
      Events to find live dates by city, or to Releases to see what is new.
    </p>

    <div class="dmap-bar">
      <div class="dmap-tog" role="group" aria-label="Map mode">
        <button type="button" data-mode="artists" aria-pressed="true">Artists</button>
        <button type="button" data-mode="events" aria-pressed="false">Events</button>
        <button type="button" data-mode="releases" aria-pressed="false">Releases</button>
      </div>
      <div class="dmap-range" role="group" aria-label="Event dates" hidden>
        <button type="button" class="chip on" data-range="30" aria-pressed="true">Next 30 days</button>
        <button type="button" class="chip" data-range="all" aria-pressed="false">All upcoming</button>
      </div>
      <div class="dmap-range" data-rrange-group role="group" aria-label="Release dates" hidden>
        <button type="button" class="chip on" data-rrange="30" aria-pressed="true">Last 30 days</button>
        <button type="button" class="chip" data-rrange="90" aria-pressed="false">Last 90 days</button>
      </div>
      <ul class="dmap-legend" data-legend="artists" aria-hidden="true">
        <li><i class="rel">3</i>Artists from the country</li>
        <li><i class="lit"></i>Selected</li>
      </ul>
      <ul class="dmap-legend" data-legend="events" aria-hidden="true" hidden>
        <li><i class="lit"></i>City with events</li>
        <li><i class="sel"></i>Selected city</li>
      </ul>
      <ul class="dmap-legend" data-legend="releases" aria-hidden="true" hidden>
        <li><i class="rel">3</i>New releases from the country</li>
        <li><i class="lit"></i>Selected</li>
      </ul>
    </div>

    <div class="dmap-grid">
      <div class="dmap-mapbox">
        <svg
          class="dmap-svg"
          viewBox={`0 0 ${grid.nx} ${grid.ny}`}
          preserveAspectRatio="xMinYMid slice"
          role="group"
          aria-label="Map of Europe drawn in dots. Use Tab to move between countries, Enter to open one."
          data-mode="artists"
        >
          {
            groups.map((g) => (
              <g
                class:list={['dmap-c', g.n > 0 && 'lit']}
                data-cc={g.code}
                tabindex={g.n > 0 ? 0 : undefined}
                role={g.inScope ? 'button' : undefined}
                aria-label={g.inScope ? (g.n > 0 ? g.name : `${g.name}, no artists yet`) : undefined}
                aria-hidden={g.inScope ? undefined : 'true'}
                set:html={g.html}
              />
            ))
          }
          <g class="dmap-ev">
            {
              [...evDots.entries()].map(([dot, d]) => (
                <g
                  class="dmap-evd"
                  data-dot={dot}
                  data-cc={d.code}
                  data-x={positions[dot][0] + 0.5}
                  data-y={positions[dot][1] + 0.5}
                  role="button"
                  tabindex="-1"
                  aria-label={`Events in ${[...d.cities].join(' and ')}`}
                >
                  <rect class="dmap-hit" x={positions[dot][0]} y={positions[dot][1]} width="1" height="1" />
                  <circle cx={positions[dot][0] + 0.5} cy={positions[dot][1] + 0.5} r={ER} />
                </g>
              ))
            }
          </g>
          <g class="dmap-rel" aria-hidden="true" data-rel-markers></g>
        </svg>
      </div>

      <aside class="dmap-panel" aria-live="polite" data-panel>
        <button type="button" class="dmap-close" aria-label="Close" data-close>×</button>
        <div data-panel-body>
          <p class="dmap-hint">Tap a country with an orange number to see its artists.</p>
        </div>
      </aside>
    </div>

    <div class="dmap-lists">
      <div class="dmap-list" data-list="artists">
        <h3>All countries</h3>
        <ul class="dmap-countries">
          {
            withArtists
              .sort((a, b) => b.artists.length - a.artists.length || a.name.localeCompare(b.name, 'en'))
              .map((c) => (
                <li id={c.slug ? `country-${c.slug}` : undefined}>
                  <details>
                    <summary>
                      <span>{c.name}</span>
                      <b>{c.artists.length}</b>
                    </summary>
                    <ul>
                      {c.artists.map((a) => (
                        <li>
                          <a class="dmap-arow" href={`/artists/${a.slug}`}>
                            {a.photo ? (
                              <img class="dmap-av" src={a.photo} srcset={`${a.photo} 1x, ${a.photo2x} 2x`} width="32" height="32" loading="lazy" decoding="async" alt={a.name} />
                            ) : (
                              <span class="dmap-av dmap-av-ph" aria-hidden="true">{initials(a.name)}</span>
                            )}
                            <span class="link">{a.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              ))
          }
        </ul>
        {
          withoutArtists.length > 0 && (
            <p class="dmap-none">No artists on CME yet from {withoutArtists.map((c) => c.name).join(', ')}.</p>
          )
        }
      </div>

      <div class="dmap-list" data-list="events" hidden>
        <h3>Upcoming events</h3>
        <ul class="dmap-events" data-events-list></ul>
        <p class="dmap-empty" data-events-empty hidden></p>
      </div>

      <div class="dmap-list" data-list="releases" hidden>
        <h3>New releases</h3>
        <ul class="dmap-events" data-releases-list></ul>
        <p class="dmap-empty" data-releases-empty hidden></p>
      </div>
    </div>
  </div>
  <script type="application/json" id="dmap-data" set:html={json} />
</section>

<script>
  type Artist = { name: string; slug: string; photo?: string; photo2x?: string };
  type Country = { code: string; name: string; slug?: string; mapCode: string; artists: Artist[] };
  type Ev = {
    id: string; title: string; start: string; timeZone?: string; venue: string; city: string;
    countryCode: string; countryName: string; dot: number | null;
  };
  type Rel = {
    id: string; title: string; type?: string; date: string; artists: Array<{ name: string; slug?: string }>;
    href?: string; cover?: string; cover2x?: string; countries: string[];
  };
  type Mode = 'artists' | 'events' | 'releases';

  const root = document.querySelector<HTMLElement>('[data-dmap]');
  const dataEl = document.getElementById('dmap-data');
  if (root && dataEl) {
    const data = JSON.parse(dataEl.textContent || '{}') as {
      countries: Country[]; events: Ev[]; releases: Rel[]; centres: Record<string, [number, number]>;
    };
    const svg = root.querySelector<SVGSVGElement>('.dmap-svg')!;
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const body = root.querySelector<HTMLElement>('[data-panel-body]')!;
    const DAY = 86400000;
    const params = new URLSearchParams(location.search);
    const asMode = (m: string | null | undefined): Mode => (m === 'events' || m === 'releases' ? m : 'artists');
    const state = {
      mode: asMode(params.get('mode')),
      range: params.get('range') === 'all' ? 'all' : '30',
      rrange: params.get('range') === '90' ? '90' : '30',
      cc: (params.get('country') || '').toUpperCase() || null as string | null,
      dot: params.get('dot') ? Number(params.get('dot')) : null as number | null,
    };

    const byMap = new Map<string, Country[]>();
    for (const c of data.countries) {
      const list = byMap.get(c.mapCode) ?? [];
      if (c.code === c.mapCode) list.unshift(c); else list.push(c);
      byMap.set(c.mapCode, list);
    }
    const countryName = (code: string) => byMap.get(code)?.[0]?.name ?? code;
    const initials = (name: string) =>
      name.replace(/[^\p{L}\p{N}\s]/gu, ' ').trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '?';
    const avatar = (a: Artist) => a.photo
      ? `<img class="dmap-av" src="${esc(a.photo)}" srcset="${esc(a.photo)} 1x, ${esc(a.photo2x || a.photo)} 2x" width="40" height="40" loading="lazy" decoding="async" alt="${esc(a.name)}">`
      : `<span class="dmap-av dmap-av-ph" aria-hidden="true">${esc(initials(a.name))}</span>`;
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');

    function inRange(e: Ev) {
      const t = Date.parse(e.start);
      const now = Date.now();
      return t >= now - 6 * 3600000 && (state.range === 'all' || t <= now + 30 * DAY);
    }
    const events = () => data.events.filter(inRange);

    // A release is new when its release date falls within the last 30 or 90 days, today included.
    // Future release dates are not counted yet.
    const ymd = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    function releases() {
      const today = new Date();
      const from = new Date(today.getFullYear(), today.getMonth(), today.getDate() - Number(state.rrange) + 1);
      const lo = ymd(from), hi = ymd(today);
      return (data.releases || []).filter((r) => r.date >= lo && r.date <= hi);
    }
    const releaseCounts = () => {
      const m = new Map<string, number>();
      for (const r of releases()) for (const c of r.countries) m.set(c, (m.get(c) ?? 0) + 1);
      return m;
    };
    // Artists per map country (Vatican City counts under Italy), each artist once per country.
    const artistCounts = new Map<string, number>();
    for (const [code, list] of byMap) {
      const n = new Set(list.flatMap((c) => c.artists.map((a) => a.slug))).size;
      if (n) artistCounts.set(code, n);
    }
    const TYPE_LABEL: Record<string, string> = { album: 'Album', ep: 'EP', single: 'Single' };
    function relRow(r: Rel) {
      const d = new Date(`${r.date}T12:00:00`);
      const date = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
      const cover = r.cover
        ? `<img class="dmap-cover" src="${esc(r.cover)}" srcset="${esc(r.cover)} 1x, ${esc(r.cover2x || r.cover)} 2x" width="48" height="48" loading="lazy" decoding="async" alt="">`
        : `<span class="dmap-cover dmap-cover-ph" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M9 18.5a3 3 0 1 1-2-2.83V5l12-2v12.5a3 3 0 1 1-2-2.83V7.4l-8 1.33z"/></svg></span>`;
      const meta = [r.type ? TYPE_LABEL[r.type] ?? r.type : '', date].filter(Boolean).join(' · ');
      const inner = `${cover}<div><b>${esc(r.title)}</b><span>${esc(r.artists.map((a) => a.name).join(', '))}</span><span class="t">${esc(meta)}</span></div>`;
      return `<li class="dmap-relrow">${r.href ? `<a href="${esc(r.href)}">${inner}</a>` : `<div class="dmap-relbox">${inner}</div>`}</li>`;
    }
    const relEmptyText = () => state.rrange === '30' ? 'No new releases in the last 30 days. Try Last 90 days.' : 'No new releases in the last 90 days yet.';
    function renderMarkers() {
      const layer = svg.querySelector<SVGGElement>('[data-rel-markers]')!;
      if (state.mode === 'events') { layer.replaceChildren(); return; }
      const counts = state.mode === 'releases' ? releaseCounts() : artistCounts;
      const out: string[] = [];
      // The map is cropped on the right on narrow screens: keep markers inside the visible part.
      const box = svg.getBoundingClientRect();
      const vb = svg.viewBox.baseVal;
      const visibleW = box.height > 0 ? Math.min(vb.width, vb.height * (box.width / box.height)) : vb.width;
      const scale = parseFloat(getComputedStyle(svg).getPropertyValue('--dmap-rm-scale')) || 1;
      for (const [code, n] of counts) {
        const c = data.centres[code];
        if (!c) continue;
        const tier = n >= 6 ? 3 : n >= 3 ? 2 : 1;
        const r = [0, 0.95, 1.15, 1.4][tier] * scale;
        const x = Math.min(c[0], visibleW - r - 0.15);
        const label = n > 99 ? '99+' : String(n);
        out.push(`<g class="dmap-rm t${tier}${code === state.cc ? ' sel' : ''}" data-cc="${esc(code)}" transform="translate(${x} ${c[1]})"><g class="s"><circle r="${[0, 0.95, 1.15, 1.4][tier]}"/><text text-anchor="middle" dominant-baseline="central">${label}</text></g></g>`);
      }
      layer.innerHTML = out.join('');
    }

    function when(e: Ev) {
      const d = new Date(e.start);
      const tz = e.timeZone || 'UTC';
      try {
        return {
          day: new Intl.DateTimeFormat('en-GB', { day: 'numeric', timeZone: tz }).format(d),
          mon: new Intl.DateTimeFormat('en-GB', { month: 'short', timeZone: tz }).format(d).toUpperCase(),
          full: new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: tz }).format(d),
        };
      } catch {
        return { day: '', mon: '', full: e.start };
      }
    }
    function evRow(e: Ev, on = false) {
      const w = when(e);
      return `<li class="dmap-evrow${on ? ' on' : ''}"><div class="d">${w.day}<small>${w.mon}</small></div><div><b>${esc(e.title)}</b><span>${esc([e.venue, e.city].filter(Boolean).join(', '))}</span><span class="t">${esc(w.full)}</span></div></li>`;
    }
    const emptyText = () => state.range === '30' ? 'No events in the next 30 days. Try All upcoming.' : 'No upcoming events yet.';

    function renderPanel() {
      const open = Boolean(state.cc);
      panel.classList.toggle('open', open);
      if (!open) {
        const hint = { artists: 'Tap a country with an orange number to see its artists.', events: 'Tap a lit city to see its events.', releases: releases().length ? 'Tap a country with an orange marker to see its new releases.' : relEmptyText() }[state.mode];
        body.innerHTML = `<p class="dmap-hint">${hint}</p>`;
        return;
      }
      const code = state.cc!;
      const name = countryName(code);
      const anchorSlug = byMap.get(code)?.[0]?.slug;
      const head = (title: string, sub: string) =>
        `<div class="dmap-ph"><span class="dmap-flag">${esc(code)}</span><div><h2>${esc(title)}</h2><p>${sub}</p></div></div>`;
      let h = '';
      if (state.mode === 'artists') {
        const groups = byMap.get(code) ?? [];
        const all = groups.flatMap((c) => c.artists.map((a) => ({ ...a, from: c.code !== code ? c.name : '' })));
        h += head(name, `${all.length} artist${all.length === 1 ? '' : 's'}`);
        if (all.length) {
          h += '<ul class="dmap-artists">' + all.slice(0, 10).map((a) =>
            `<li><a href="/artists/${esc(a.slug)}">${avatar(a)}<span>${esc(a.name)}</span>${a.from ? `<small>${esc(a.from)}</small>` : ''}</a></li>`).join('') + '</ul>';
          if (all.length > 10) h += `<p class="dmap-more">Showing 10 of ${all.length}.</p>`;
        } else {
          h += '<p class="dmap-hint">No artists from here on CME yet.</p>';
        }
        if (anchorSlug && all.length) h += `<a class="btn pur dmap-btn" href="#country-${esc(anchorSlug)}" data-open-country="${esc(anchorSlug)}">All artists from ${esc(name)}</a>`;
      } else if (state.mode === 'releases') {
        const rel = releases().filter((r) => r.countries.includes(code));
        h += head(name, `${rel.length} new release${rel.length === 1 ? '' : 's'} in the last ${state.rrange} days`);
        h += rel.length ? '<ul class="dmap-evs">' + rel.map(relRow).join('') + '</ul>' : `<p class="dmap-hint">${relEmptyText()}</p>`;
        const hasArtists = (byMap.get(code) ?? []).some((c) => c.artists.length);
        if (anchorSlug && hasArtists) h += `<a class="btn pur dmap-btn" href="#country-${esc(anchorSlug)}" data-open-country="${esc(anchorSlug)}">All artists from ${esc(name)}</a>`;
      } else {
        const ev = events().filter((e) => e.countryCode === code);
        const here = state.dot !== null ? ev.filter((e) => e.dot === state.dot) : [];
        if (here.length) {
          const cities = [...new Set(here.map((e) => e.city))].join(' and ');
          h += head(cities, `${esc(name)} · ${here.length} event${here.length === 1 ? '' : 's'} here, ${ev.length} in the country`);
          h += '<ul class="dmap-evs">' + here.map((e) => evRow(e, true)).join('') + '</ul>';
          const rest = ev.filter((e) => e.dot !== state.dot);
          if (rest.length) h += `<p class="meta dmap-sect">Elsewhere in ${esc(name)}</p><ul class="dmap-evs">` + rest.map((e) => evRow(e)).join('') + '</ul>';
        } else {
          h += head(name, `${ev.length} upcoming event${ev.length === 1 ? '' : 's'}`);
          h += ev.length ? '<ul class="dmap-evs">' + ev.map((e) => evRow(e)).join('') + '</ul>' : `<p class="dmap-hint">${emptyText()}</p>`;
        }
      }
      body.innerHTML = h;
    }

    function renderEventsList() {
      const list = root!.querySelector<HTMLElement>('[data-events-list]')!;
      const empty = root!.querySelector<HTMLElement>('[data-events-empty]')!;
      const ev = events();
      const byCountry = new Map<string, Ev[]>();
      for (const e of ev) byCountry.set(e.countryName, [...(byCountry.get(e.countryName) ?? []), e]);
      list.innerHTML = [...byCountry.entries()].sort((a, b) => a[0].localeCompare(b[0], 'en'))
        .map(([c, es]) => `<li><h4>${esc(c)}</h4><ul class="dmap-evs">${es.map((e) => evRow(e)).join('')}</ul></li>`).join('');
      empty.hidden = ev.length > 0;
      empty.textContent = emptyText();
    }

    function renderReleasesList() {
      const list = root!.querySelector<HTMLElement>('[data-releases-list]')!;
      const empty = root!.querySelector<HTMLElement>('[data-releases-empty]')!;
      const rel = releases();
      const byCountry = new Map<string, Rel[]>();
      for (const r of rel) for (const c of r.countries) byCountry.set(countryName(c), [...(byCountry.get(countryName(c)) ?? []), r]);
      list.innerHTML = [...byCountry.entries()].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], 'en'))
        .map(([c, rs]) => `<li><h4>${esc(c)}</h4><ul class="dmap-evs">${rs.map(relRow).join('')}</ul></li>`).join('');
      empty.hidden = rel.length > 0;
      empty.textContent = relEmptyText();
    }

    function render() {
      svg.dataset.mode = state.mode;
      const visibleDots = new Set(events().map((e) => e.dot).filter((d): d is number => d !== null));
      const relCounts = releaseCounts();
      svg.querySelectorAll<SVGGElement>('.dmap-c').forEach((g) => {
        const sel = g.dataset.cc === state.cc;
        const cc = g.dataset.cc!;
        const nRel = relCounts.get(cc) ?? 0;
        g.classList.toggle('sel', sel);
        g.classList.toggle('has-rel', nRel > 0);
        const focusable = (state.mode === 'artists' && g.classList.contains('lit')) || (state.mode === 'releases' && nRel > 0);
        if (focusable) g.setAttribute('tabindex', '0');
        else g.removeAttribute('tabindex');
        if (g.getAttribute('role') === 'button') {
          const name = countryName(cc);
          const label = state.mode === 'releases'
            ? `${name}, ${nRel || 'no'} new release${nRel === 1 ? '' : 's'}`
            : (() => { const n = artistCounts.get(cc) ?? 0; return n ? `${name}, ${n} artist${n === 1 ? '' : 's'}` : `${name}, no artists yet`; })();
          g.setAttribute('aria-label', label);
        }
      });
      renderMarkers();
      svg.querySelectorAll<SVGGElement>('.dmap-evd').forEach((c) => {
        const dot = Number(c.dataset.dot);
        const show = state.mode === 'events' && visibleDots.has(dot);
        c.classList.toggle('on', show);
        c.classList.toggle('sel', show && dot === state.dot);
        c.setAttribute('tabindex', show ? '0' : '-1');
        c.setAttribute('aria-hidden', show ? 'false' : 'true');
      });
      root!.querySelectorAll<HTMLButtonElement>('button[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === state.mode)));
      root!.querySelectorAll<HTMLButtonElement>('button[data-range]').forEach((b) => {
        const on = b.dataset.range === state.range;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('on', on);
      });
      root!.querySelectorAll<HTMLButtonElement>('button[data-rrange]').forEach((b) => {
        const on = b.dataset.rrange === state.rrange;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('on', on);
      });
      root!.querySelector<HTMLElement>('.dmap-range:not([data-rrange-group])')!.hidden = state.mode !== 'events';
      root!.querySelector<HTMLElement>('[data-rrange-group]')!.hidden = state.mode !== 'releases';
      root!.querySelectorAll<HTMLElement>('[data-legend]').forEach((l) => { l.hidden = l.dataset.legend !== state.mode; });
      root!.querySelectorAll<HTMLElement>('[data-list]').forEach((l) => { l.hidden = l.dataset.list !== state.mode; });
      renderPanel();
      renderEventsList();
      renderReleasesList();
    }

    function selectCountry(code: string) { state.cc = code; state.dot = null; render(); }
    function selectDot(el: SVGGElement) { state.cc = el.dataset.cc || null; state.dot = Number(el.dataset.dot); render(); }

    svg.addEventListener('click', (ev) => {
      const t = ev.target as Element;
      const evd = t.closest<SVGGElement>('.dmap-evd.on');
      if (evd) return selectDot(evd);
      const rm = t.closest<SVGGElement>('.dmap-rm');
      if (rm) return selectCountry(rm.dataset.cc!);
      const g = t.closest<SVGGElement>('.dmap-c');
      if (!g || g.getAttribute('role') !== 'button') return;
      if (state.mode === 'events') {
        // Anywhere in a country selects its nearest lit event city, if it has one.
        const m = svg.getScreenCTM();
        const p = m ? new DOMPoint(ev.clientX, ev.clientY).matrixTransform(m.inverse()) : null;
        let best: SVGGElement | null = null, bestD = Infinity;
        svg.querySelectorAll<SVGGElement>(`.dmap-evd.on[data-cc="${g.dataset.cc}"]`).forEach((d) => {
          const dd = p ? (Number(d.dataset.x) - p.x) ** 2 + (Number(d.dataset.y) - p.y) ** 2 : 0;
          if (dd < bestD) { bestD = dd; best = d; }
        });
        if (best) return selectDot(best);
      }
      selectCountry(g.dataset.cc!);
    });
    svg.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Enter' && ev.key !== ' ') return;
      const t = ev.target as Element;
      if (t.classList.contains('dmap-evd')) { ev.preventDefault(); selectDot(t as SVGGElement); }
      else if (t.classList.contains('dmap-c')) { ev.preventDefault(); selectCountry((t as SVGGElement).dataset.cc!); }
    });
    root.querySelectorAll<HTMLButtonElement>('button[data-mode]').forEach((b) => b.addEventListener('click', () => {
      state.mode = asMode(b.dataset.mode); state.dot = null; render();
    }));
    root.querySelectorAll<HTMLButtonElement>('button[data-rrange]').forEach((b) => b.addEventListener('click', () => {
      state.rrange = b.dataset.rrange === '90' ? '90' : '30'; render();
    }));
    root.querySelectorAll<HTMLButtonElement>('button[data-range]').forEach((b) => b.addEventListener('click', () => {
      state.range = b.dataset.range === 'all' ? 'all' : '30'; render();
    }));
    let resizeTimer = 0;
    addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = window.setTimeout(renderMarkers, 150); });
    root.querySelector('[data-close]')!.addEventListener('click', () => { state.cc = null; state.dot = null; render(); });
    body.addEventListener('click', (ev) => {
      const a = (ev.target as Element).closest<HTMLAnchorElement>('[data-open-country]');
      if (!a) return;
      const d = document.querySelector<HTMLDetailsElement>(`#country-${CSS.escape(a.dataset.openCountry!)} details`);
      if (d) d.open = true;
    });
    if (state.mode === 'events' && state.cc && state.dot === null) {
      const first = events().find((e) => e.countryCode === state.cc && e.dot !== null);
      if (first) state.dot = first.dot;
    }
    render();
  }
</script>

